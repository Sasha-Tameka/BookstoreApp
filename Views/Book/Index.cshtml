@{
    ViewData["Title"] = "Book Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - 📚 BookHive</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #a78bfa, #60a5fa);
            color: #fff;
            min-height: 100vh;
            padding-top: 80px;
        }

       .navbar {
            display: flex;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(to right, #a78bfa, #60a5fa);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            z-index: 1000;
        }

        .nav-brand {
            font-weight: bold;
            color: #ffffff;
            font-size: 1.50rem;
        }

        .nav-links a {
            margin-left: 1.5rem;
            text-decoration: none;
            color: #f1f5f9;
            font-weight: 500;
        }

        .nav-links a:hover {
            color: #ffffff;
        }

        h2 {
            text-align: center;
            margin: 2rem 0 1rem;
        }

        .auth-buttons {
            display: flex;
            justify-content: flex-end;
            max-width: 1100px;
            margin: 1rem auto;
        }

        .btn {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background-color: #3b82f6;
            color: white;
            font-size: medium;
            margin: 1rem auto;
            display: block;
            width: fit-content;
        }

        .btn-logout {
            background-color: #ef4444;
            color: white;
            font-size: small;
        }

        .table {
            color: #fff;
            width: 90%;
            margin: 2rem auto;
            border-collapse: collapse;
            background-image: url("/css/images/books1.jpg");
            background-size: cover;
            background-position: center;
            color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            backdrop-filter: brightness(0.8); /* optional: dims the background a little */
        }


        .table td, .table th {
            background-color: rgba(0, 0, 0, 0.4); /* Optional: for contrast */
            color: white;
            padding: 1rem;
            text-align: left;
        }


        .table thead {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .table tbody tr:nth-child(even) {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.15);
        }

        .table th {
            font-weight: bold;
        }

        .action-btn {
            margin-right: 0.5rem;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-weight: 600;
            text-decoration: none;
            color: white;
        }



        

    </style>
</head>
<body>
    <!-- Navbar -->
    <div class="navbar">
        <div class="nav-brand">📚 BookHive</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Book/Index">Book List</a>
           
        </div>
    </div>
<h2>Book List</h2>
<br>
<a class="btn btn-primary" href="/Book/Add">Add New Book</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Actions</th>

        </tr>
    </thead>
    <tbody id="books-table-body">
        <!-- Books will be loaded here dynamically -->
    </tbody>
</table>

<script type="module" src="/js/firebase-books.js"></script>
</body>
</html>