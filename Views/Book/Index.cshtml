
@{
    ViewData["Title"] = "Book Page";
}
<style>

<div class="auth-buttons mb-4">
    <a class="btn btn-logout" href="http://localhost:5233" id="logout-link">Logout</a>
</div>  
</style>
<h2>Book List</h2>
<a class="btn btn-primary" href="/Book/Add">Add New Book</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="books-table-body">
        <!-- Books will be loaded here dynamically -->
    </tbody>
</table>

<script type="module" src="/js/firebase-books.js"></script>