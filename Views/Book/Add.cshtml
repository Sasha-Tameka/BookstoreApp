@{
    ViewData["Title"] = "Add Book";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - BookstoreApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
 /* Reset default margins/paddings for consistency */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
/* Full page background and general body styling */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #a78bfa, #60a5fa); /* Purple to blue gradient */
            color: #fff;
            min-height: 100vh;
            padding-top: 80px; /* Prevent navbar overlap */
        }
    </style>
</head>
<body>
        <!-- Navbar -->
    <div class="navbar">
        <div class="nav-brand">📚 BookstoreApp</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Book/Index">Book List</a>
            <a href="/Auth/Login">Login</a>
            <a href="/Auth/Signup">Sign Up</a>
        </div>
    </div>

        

    <!-- Page Content -->
    <h2>Add New Book</h2>

    <form id="add-book-form">
        <label>Title</label>
        <input class="form-control" name="title" required />

        <label>Author</label>
        <input class="form-control" name="author" required />

        <label>Price</label>
        <input class="form-control" name="price" type="number" step="0.01" required />

        <button type="submit" class="btn btn-success">Save</button>
        <a href="/Book/Index" class="btn btn-secondary">Cancel</a>
    </form>

    <script type="module" src="/js/firebase-books.js"></script>
</body>
</html>
