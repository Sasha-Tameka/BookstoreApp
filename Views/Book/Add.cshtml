@{
    ViewData["Title"] = "Add Book";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - 📚 BookHive</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&display=swap" rel="stylesheet">

     <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />
    <style>
 /* Reset default margins/paddings for consistency */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
/* Full page background and general body styling */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #a78bfa, #60a5fa); /* Purple to blue gradient */
            color: #fff;
            min-height: 100vh;
            padding-top: 80px; /* Prevent navbar overlap */
        }
            /* Navbar styling */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(to right, #a78bfa, #60a5fa); /* Match body background */
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            z-index: 1000; 
        }

        /* Navbar title styling */
        .nav-brand {
            font-weight: bold;
            color: #ffffff;
            font-size: 1.50rem;

        }

        /* Navbar link container */
        .nav-links a {
            margin-left: 1.5rem;
            text-decoration: none;
            color: #f1f5f9;
            font-weight: 500;
        }

        /* Navbar link hover effect */
        .nav-links a:hover {
            color: #ffffff;
        }
         /* Page title */
        h2 {
            font-family: "Covered By Your Grace", cursive;
            font-weight: 400;
            font-style: normal;
            font-size: 3rem;
            margin-top: 3rem;
            text-align: center;
            margin: 2rem 0 1rem;
        }
        
        /* Form container styling */
        form {
            max-width: 500px;
            margin: 2rem auto;
            background-color: rgba(255, 255, 255, 0.1); /* Semi-transparent white background */
            padding: 2rem;
            border-radius: 12px;
        }
        /* Label styling */
        label {
            display: block;
            margin: 1rem 0 0.5rem;
            font-weight: 600;
        }
        /* Input field styling */
        input.form-control {
            width: 100%;
            padding: 0.6rem;
            border: none;
            border-radius: 8px;
        }
         /* Button base styles */
        button, a.btn {
            margin-top: 1rem;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            display: inline-block;
        }

        /* Save button (green) */
        .btn-success {
            background-color: #059669;
            color: white;
            font-size: medium;
        }

        /* Cancel button (gray) */
        .btn-secondary {
            background-color: #6b7280;
            color: white;
            margin-left: 1rem;
            font-size: small;
            
        }

    </style>
</head>
<body>
        <!-- Navbar -->
    <div class="navbar">
        <div class="nav-brand">📚 BookHive</div>
        <div class="nav-links">
            <a href="/Home/Privacy">Privacy</a>
            <a href="/Home/Index">Logout</a>
            
        </div>
    </div>

        

    <!-- Page Content -->
    <h2 class="animate__animated animate__flipInX">Add New Book</h2>

    <form id="add-book-form">
        <label>Title</label>
        <input class="form-control" name="title" required />

        <label>Author</label>
        <input class="form-control" name="author" required />

        <label>Price</label>
        <input class="form-control" name="price" type="number" step="0.01" required />

        <button type="submit" class="btn btn-success">Save</button>
        <a href="/Book/Index" class="btn btn-secondary">Cancel</a>
    </form>

    <script type="module" src="/js/firebase-books.js"></script>
</body>
</html>
