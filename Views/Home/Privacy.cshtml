@{
    ViewData["Title"] = "Privacy Policy";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - 📚 BookHive</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #a78bfa, #60a5fa); /* Match your other pages */
            color: #f1f5f9;
            min-height: 100vh;
            padding-top: 80px;
        }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(to right, #a78bfa, #60a5fa);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            z-index: 1000;
        }

        .nav-brand {
            font-weight: bold;
            color: #ffffff;
            font-size: 1.5rem;
        }

        .nav-links a {
            margin-left: 1.5rem;
            text-decoration: none;
            color: #f1f5f9;
            font-weight: 500;
        }

        .nav-links a:hover {
            color: #ffffff;
        }

        /* Page content styling */
        .content-container {
            max-width: 800px;
            margin: 3rem auto;
            background-color: rgba(255, 255, 255, 0.1);
            padding: 2rem;
            border-radius: 12px;
            text-align: center;
        }

        h2 {
            margin-bottom: 1.5rem;
            font-size: 2rem;
            font-weight: bold;
        }

        p {
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        /* Return Home button */
        .btn-home {
            margin-top: 2rem;
            display: inline-block;
            background-color: #059669; /* Green like your Save button */
            color: white;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            transition: background-color 0.3s;
        }

        .btn-home:hover {
            background-color: #047857; /* Darker green */
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <div class="navbar">
        <div class="nav-brand">📚 BookHive</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Auth/Login">Login</a>
            <a href="/Auth/Signup">Sign Up</a>
        </div>
    </div>

    <!-- Privacy Content -->
    <div class="content-container">
        <h2>Privacy Policy</h2>
        <p>At <strong>BookHive</strong>, your privacy is important to us. We are committed to protecting the personal information you share with us.</p>
        <p>We only collect the information necessary to improve your experience on our site. Your data will never be sold, shared, or disclosed without your permission, unless required by law.</p>
        <p>By using our website, you agree to the terms of this Privacy Policy. If you have any questions or concerns, feel free to reach out to our support team.</p>

        <!-- Return Home Button -->
        <a href="/" class="btn-home">Return to Home</a>
    </div>

</body>
</html>

