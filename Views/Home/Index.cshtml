@{
    ViewData["Title"] = "HomePage";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - 📚 BookHive</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&display=swap" rel="stylesheet">

    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />
    <style>
       
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
           
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #a78bfa, #60a5fa);
            color: #fff;
            min-height: 100vh;
            padding: 2rem;
            text-align: center;
            
        }
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(to right, #a78bfa, #60a5fa);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            z-index: 1000;
        }
        .nav-brand {
            font-weight: bold;
            color: #ffffff;
            font-size: 1.50rem;
        }

        .nav-links a {
            margin-left: 1.5rem;
            text-decoration: none;
            color: #f1f5f9;
            font-weight: 500;
        }

        .nav-links a:hover {
            color: #ffffff;
        }
        .auth-buttons {
            margin-bottom: 2rem;
        }

        .btn {
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            margin: 0.5rem;
            display: inline-block;
        }

        .btn-login {
            background-color: #3b82f6;
            color: white;
            font-size: medium;
        }

        .btn-login:hover {
            background-color: #2563eb;
        }

        .btn-signup {
            background-color: #10b981;
            color: white;
            font-size: medium;
        }

        .btn-signup:hover {
            background-color: #059669;
        }

        h1 {
            font-family: "Covered By Your Grace", cursive;
            font-weight: 400;
            font-style: normal;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
            color: #E69138;
        }

        p {
            font-family: "Kaushan Script", cursive;
            font-weight: 400;
            font-style: normal;
            font-size: 1.5rem;
            margin: 1rem auto;
            max-width: 700px;
        }

        a.inline-link {
            color: darkgreen;
            text-decoration: underline;
            font-weight: bold;
        }

        h2 {
            font-family: "Covered By Your Grace", cursive;
            font-weight: 400;
            font-style: normal;
            margin-top: 3rem;
            font-size: 2.5rem;
        }

        .table {
            color: #fff;
            width: 90%;
            margin: 2rem auto;
            border-collapse: collapse;
            background-image: url("/css/images/book2.jpg");
            background-size: cover;
            background-position: center;
            color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            backdrop-filter: brightness(0.8); /* optional: dims the background a little */
        }


        .table td, .table th {
            background-color: rgba(0, 0, 0, 0.4); /* Optional: for contrast */
            color: white;
            padding: 1rem;
            text-align: left;
        }


        .table thead {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .table tbody tr:nth-child(even) {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.15);
        }

        .table th {
            font-weight: bold;
        }

        .divider {
    border: none;
    height: 2px;
    background: #ffffff; /* white line */
    opacity: 0.4; /* a bit transparent */
    margin: 2rem auto;
    width: 80%;
}



    </style>
</head>
<body>
     <!-- Navbar -->
    <div class="navbar">
        <div class="nav-brand">📚 BookHive</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Home/Privacy">Privacy</a>
        
        </div>
    </div>
<br>
<br>
<br>

<div class="text-center">
    <div class="auth-buttons mb-4">
        <a class="btn btn-login" asp-area="" asp-controller="Auth" asp-action="Login" id="login-link">Login</a>
        <a class="btn btn-signup" asp-area="" asp-controller="Auth" asp-action="Signup" id="signup-link">Signup</a>
    </div>

    <h1 class="animate__animated animate__bounce">Welcome to 📚 BookHive!</h1>

    <p>
        Discover your next favorite book or keep track of the ones you love!
    </p>

    <p>
        To add, edit, or delete books from your personal collection, please make sure to 
        <a class ="inline-link" asp-controller="Auth" asp-action="Signup">sign up</a> or 
        <a class="inline-link" asp-controller="Auth" asp-action="Login">login</a>.
    </p>
    <br>

    <p>
        Happy reading! 📖✨
    </p>

    <hr class="divider" />

    <h2 >Book List</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody id="books-table-body">
            <!-- Books will be loaded here dynamically -->
        </tbody>
    </table>
</div>

<script type="module" src="/js/firebase-bookNotAuth.js"></script>

</body>
</html>
