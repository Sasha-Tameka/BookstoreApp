@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <div class="auth-buttons mb-4"></div>
    <a class="btn btn-login me-2" asp-area="" asp-controller="Auth" asp-action="Login" id="login-link">Login</a>
    <a class="btn btn-signup" asp-area="" asp-controller="Auth" asp-action="Signup" id="signup-link">Signup</a>
</div>
    <h1 class="display-4">Welcome to BookstoreApp</h1>


    <p>
        This is the list of books:
      
    </p>

    <h4 class="display-4">
        For adding new books or edit or delete any books you need to Authenticate
    </h4>

    <h2 >Book List</h2>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
        </tr>
    </thead>
     <tbody id="books-table-body">
        <!-- Books will be loaded here dynamically -->
    </tbody>
</table>
</div>

<script type="module" src="/js/firebase-bookNotAuth.js"></script>
