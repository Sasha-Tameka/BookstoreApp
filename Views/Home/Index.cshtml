@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - 📚 BookHive</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #a78bfa, #60a5fa);
            color: #fff;
            min-height: 100vh;
            padding: 2rem;
            text-align: center;
        }

        .auth-buttons {
            margin-bottom: 2rem;
        }

        .btn {
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            margin: 0.5rem;
            display: inline-block;
        }

        .btn-login {
            background-color: #3b82f6;
            color: white;
            font-size: medium;
        }

        .btn-login:hover {
            background-color: #2563eb;
        }

        .btn-signup {
            background-color: #10b981;
            color: white;
            font-size: medium;
        }

        .btn-signup:hover {
            background-color: #059669;
        }

        h1 {
            font-size: 2.8rem;
            margin-bottom: 1.5rem;
        }

        p {
            font-size: 1.2rem;
            margin: 1rem auto;
            max-width: 700px;
        }

        a.inline-link {
            color: #3b82f6;
            text-decoration: underline;
            font-weight: bold;
        }

        h2 {
            margin-top: 3rem;
            font-size: 2rem;
        }

        .table {
            color: #fff;
            width: 90%;
            margin: 2rem auto;
            border-collapse: collapse;
            background-image: url("/css/images/books1.jpg");
            background-size: cover;
            background-position: center;
            border-radius: 12px;
            overflow: hidden;
            backdrop-filter: brightness(0.8);
        }

        .table th, .table td {
            background-color: rgba(0, 0, 0, 0.4);
            padding: 1rem;
            text-align: left;
        }

        .table thead {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .table tbody tr:nth-child(even) {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.15);
        }

    </style>
</head>
<body>

<div class="text-center">
    <div class="auth-buttons mb-4">
        <a class="btn btn-login" asp-area="" asp-controller="Auth" asp-action="Login" id="login-link">Login</a>
        <a class="btn btn-signup" asp-area="" asp-controller="Auth" asp-action="Signup" id="signup-link">Signup</a>
    </div>

    <h1>Welcome to 📚 BookHive!</h1>

    <p>
        Discover your next favorite book or keep track of the ones you love!
    </p>

    <p>
        To add, edit, or delete books from your personal collection, please make sure to 
        <a href="/Account/Register" class="inline-link">sign up</a> or 
        <a href="/Account/Login" class="inline-link">login</a>.
    </p>

    <p>
        Happy reading! 📖✨
    </p>

    <h2>Book List</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody id="books-table-body">
            <!-- Books will be loaded here dynamically -->
        </tbody>
    </table>
</div>

<script type="module" src="/js/firebase-bookNotAuth.js"></script>

</body>
</html>
